{
	"size": 0,
	"query": {
		"bool": {
			"must": [
				{
					"range": {
						"@timestamp": {
							"gte": "now-1d/d",
							"lte": "now/d"
						}
					}
				},
				{
					"term": {
						"category.keyword": "{{entity}}"
					}
				}
			],
			"should": [
				{
					"range": {
						"system.cpu.user.norm.pct": {
							"gte": 0.8
						}
					}
				},
				{
					"range": {
						"system.cpu.system.norm.pct": {
							"gte": 0.8
						}
					}
				}
			],
			"minimum_should_match": 1
		}
	},
	"aggs": {
		"group_by_hostname": {
			"terms": {
				"field": "host.hostname.keyword",
				"size": 10000
			},
			"aggs": {
				"high_cpu_usage": {
					"top_hits": {
						"size": 1000,
						"sort": [
							{
								"@timestamp": {
									"order": "desc"
								}
							}
						],
						"_source": {
							"includes": [
								"@timestamp",
								"system.cpu.user.norm.pct",
								"system.cpu.system.norm.pct",
								"system.cpu.total.norm.pct"
							]
						}
					}
				}
			}
		}
	}
}